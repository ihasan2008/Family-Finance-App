# Family Finance Environment Configuration
# Secrets are managed via the AI Studio Secrets panel (never commit real secrets to .env).
#
# Optional: Debug App Check token for local development outside AI Studio runtime injection.
# In debug builds inside AI Studio, FIREBASE_APPCHECK_DEBUG_TOKEN is delivered via Intent extras.
# FIREBASE_APPCHECK_DEBUG_TOKEN=YOUR_DEBUG_APPCHECK_TOKEN
#
# GEMINI_API_KEY (unused in this module; leave commented unless Gemini REST SDK is added)
# GEMINI_API_KEY=MY_GEMINI_API_KEY
#
# Trusted Cloud Functions base URL (used for auth, passkeys, and LiveKit meet tokens):
# AUTH_FUNCTIONS_BASE_URL=https://us-central1-<your-project-id>.cloudfunctions.net/authApi
#
# LiveKit SFU WebSocket URL (client-safe; keep LIVEKIT_API_SECRET strictly in functions/.env):
# LIVEKIT_URL=wss://your-project.livekit.cloud
#
# Optional WebRTC STUN/TURN servers for 1-to-1 P2P calls across symmetric NATs:
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# WEBRTC_TURN_URLS=turn:turn.your-provider.com:3478?transport=udp,turns:turn.your-provider.com:5349?transport=tcp
# WEBRTC_TURN_USERNAME=your_turn_username
# WEBRTC_TURN_CREDENTIAL=your_turn_credential

