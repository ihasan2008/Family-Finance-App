  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and account security metadata scoped strictly to the owning UID."
    },
    "/users/{userId}/passkeys/{credentialId}": {
      "schema": { "$ref": "#/entities/PasskeyCredential" },
      "description": "Public WebAuthn/FIDO2 passkey metadata written server-side; owner-readable and revocable."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/DeviceSession" },
      "description": "Device session tracking and remote session revocation ledger per user."
    },
    "/users/{userId}/fcm_tokens/{deviceId}": {
      "schema": { "$ref": "#/entities/FcmDeviceToken" },
      "description": "FCM push notification registration tokens scoped strictly to the owning UID."
    },
    "/family_invites/{tokenHash}": {
      "schema": { "$ref": "#/entities/FamilyInviteLookup" },
      "description": "Non-listable SHA-256 token lookup enforcing valid expiring invitation tokens."
    },
    "/families/{familyId}": {
      "schema": { "$ref": "#/entities/Family" },
      "description": "Isolated family workspaces accessible only to authorized family members."
    },
    "/families/{familyId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/FamilyMember" },
      "description": "Family member records scoped under each isolated family."
    },
    "/families/{familyId}/member_cards/{userId}": {
      "schema": { "$ref": "#/entities/MemberCard" },
      "description": "Digital Member Card & privacy preferences scoped per family member without exposing DOB, mobile number, or passwords."
    },
    "/families/{familyId}/invitations/{invitationId}": {
      "schema": { "$ref": "#/entities/FamilyInvitation" },
      "description": "Expiring invitation ledger accessible only to Family Admins."
    },
    "/families/{familyId}/join_requests/{requesterUid}": {
      "schema": { "$ref": "#/entities/FamilyJoinRequest" },
      "description": "Token-backed join requests awaiting explicit Family Admin approval."
    },
    "/familyMembers/{membershipId}": {
      "schema": { "$ref": "#/entities/FamilyMember" },
      "description": "Normalized top-level family member directory scoped by familyId and memberUids."
    },
    "/invitations/{invitationId}": {
      "schema": { "$ref": "#/entities/FamilyInvitation" },
      "description": "Normalized top-level invitation directory scoped to Family Admins."
    },
    "/transactions/{recordId}": {
      "schema": { "$ref": "#/entities/TransactionRecord" },
      "description": "Normalized income, expense, and transfer records isolated by familyId."
    },
    "/loans/{recordId}": {
      "schema": { "$ref": "#/entities/LoanRecord" },
      "description": "Normalized household loan records isolated by familyId."
    },
    "/savings/{recordId}": {
      "schema": { "$ref": "#/entities/SavingsRecord" },
      "description": "Normalized household savings goal records isolated by familyId."
    },
    "/investments/{recordId}": {
      "schema": { "$ref": "#/entities/InvestmentRecord" },
      "description": "Normalized household investment holdings isolated by familyId."
    },
    "/budgets/{recordId}": {
      "schema": { "$ref": "#/entities/BudgetRecord" },
      "description": "Normalized period budget envelopes isolated by familyId."
    },
    "/chats/{messageId}": {
      "schema": { "$ref": "#/entities/FamilyChatMessage" },
      "description": "Normalized family chat messages isolated by familyId."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/FamilyNotification" },
      "description": "Normalized household notifications isolated by familyId and recipientUserId."
    },
    "/auditLogs/{auditId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Append-only immutable audit log collection isolated by familyId."
    },
    "/financialEvents/{eventId}": {
      "schema": { "$ref": "#/entities/FinancialEvent" },
      "description": "Append-only chronological history for loans, savings, investments, and budgets."
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallSession" },
      "description": "1-to-1 WebRTC signaling and call history restricted strictly to caller and callee within the family."
    },
    "/calls/{callId}/iceCandidates/{candidateId}": {
      "schema": { "$ref": "#/entities/IceCandidateEntry" },
      "description": "WebRTC ICE candidates restricted strictly to the parent call participants."
    },
    "/meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/FamilyMeeting" },
      "description": "LiveKit SFU group meetings and scheduled sessions isolated by familyId."
    },
    "/families/{familyId}/approval_settings/{configId}": {
      "schema": { "$ref": "#/entities/ApprovalSettings" },
      "description": "Admin-configurable family voting and proposal rules isolated per family."
    },
    "/meetings/{meetingId}/participants/{participantUid}": {
      "schema": { "$ref": "#/entities/MeetingParticipant" },
      "description": "Per-participant meeting state and host moderation flags within a family meeting."
    },
    "/proposals/{proposalId}": {
      "schema": { "$ref": "#/entities/FamilyProposal" },
      "description": "Financial decision proposals isolated by familyId with anti-tamper state transitions."
    },
    "/proposals/{proposalId}/votes/{voterUid}": {
      "schema": { "$ref": "#/entities/ProposalVote" },
      "description": "One vote per eligible voter keyed by voterUid."
    },
    "/proposals/{proposalId}/vote_history/{historyId}": {
      "schema": { "$ref": "#/entities/ProposalVoteHistory" },
      "description": "Append-only immutable voting audit log per proposal."
    }
  }
}
