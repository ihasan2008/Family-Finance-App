# Firebase Cloud Functions Server Secrets (never bundle into the Android client)
# Configure via Firebase Functions Secrets / .env before deploying /functions:
# firebase functions:secrets:set LIVEKIT_API_KEY
# firebase functions:secrets:set LIVEKIT_API_SECRET

# WebSocket URL of your LiveKit Cloud project or self-hosted LiveKit SFU server:
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API Key & Secret from LiveKit Cloud Dashboard -> Settings -> Keys:
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
